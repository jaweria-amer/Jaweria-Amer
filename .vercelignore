# Files and directories that should not be included in the Vercel deployment.
# Vercel also respects .gitignore, so anything there is already excluded.

# Runtime data written by the app (CMS JSON, submissions) — filesystem is
# read-only on Vercel, so these are irrelevant to the deploy bundle.
data/

# Scripts only used locally — except scripts/results/, whose privacy gate runs
# as prebuild/postbuild on Vercel. `vercel deploy` (CLI) does not honour a
# `scripts/*` + `!scripts/results/` re-include, which uploaded a bundle without
# the gate and failed the build, so exclude by file type instead.
scripts/*.ts
scripts/*.js
scripts/*.mjs
scripts/source/

# Nested project copy (safety net — also in .gitignore)
jaweria-amer/

# Archive formats never needed by runtime
*.zip
*.tar

# PDFs are served via Supabase Storage — exclude all from deploy bundle
*.pdf
